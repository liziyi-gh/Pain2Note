{
  "name": "pain2note",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test:ui": "playwright test",
    "test:desktop": "npm run build && cargo run --release --features custom-protocol --manifest-path src-tauri/Cargo.toml --example desktop_smoke",
    "format": "prettier --write src && cargo fmt --manifest-path src-tauri/Cargo.toml",
    "tauri": "tauri",
    "desktop": "tauri dev",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "lint:rust": "cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-dialog": "^2.0.0",
    "lucide-svelte": "^0.468.0",
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@sveltejs/vite-plugin-svelte": "^6.0.0",
    "@tauri-apps/cli": "^2.0.0",
    "@types/node": "^24.0.0",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte-check": "^4.0.0",
    "typescript": "~5.9.0",
    "vite": "^7.0.0"
  }
}
